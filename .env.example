# Copy to .env (repo root for Docker, or backend/.env for local dev). Never commit .env.

# --- AI provider -------------------------------------------------------------------------
# Free options:
#   ollama  -> local model on your machine, no key (install Ollama, then `ollama pull qwen2.5-coder:7b`)
#   gemini  -> Google Gemini free tier; create a key at https://aistudio.google.com/apikey
# Paid options: anthropic | openai.   Or: none
LLM_PROVIDER=ollama
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model override. Defaults: qwen2.5-coder:7b (ollama), gemini-3.8-flash (gemini),
# claude-opus-5-5 (anthropic), gpt-4.1 (openai)
# LLM_MODEL=
# Optional API base URL override (e.g. Ollama on another machine: http://192.168.1.20:11434/v1).
# Inside Docker, reach Ollama on the host with: LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_BASE_URL=

# --- Security ----------------------------------------------------------------------------
# Encrypts stored data-source credentials. Use a long random value outside local dev.
SECRET_KEY=change-me-to-a-long-random-string

# --- Databases ---------------------------------------------------------------------------
# Local dev defaults to SQLite files in backend/data/ and needs none of these.
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot
# DEMO_DATABASE_URL=postgresql://reader:password@localhost:5432/sales_demo
# DEMO_SEED_DATABASE_URL=postgresql://owner:password@localhost:5432/sales_demo

# Docker Compose passwords
POSTGRES_PASSWORD=datapilot
READER_PASSWORD=reader

# --- Query guard rails -------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000
MAX_SQL_REPAIR_ATTEMPTS=2
CONTEXT_TURNS=4
LOG_LEVEL=INFO
