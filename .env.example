# Copy to .env (repo root for Docker, or backend/.env for local dev). Never commit .env.

# --- AI provider -------------------------------------------------------------------------
# anthropic (default) | openai | none
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model override (defaults: claude-opus-5-5 for Anthropic, gpt-4.1 for OpenAI)
# LLM_MODEL=

# --- Security ----------------------------------------------------------------------------
# Encrypts stored data-source credentials. Use a long random value outside local dev.
SECRET_KEY=change-me-to-a-long-random-string

# --- Databases ---------------------------------------------------------------------------
# Local dev defaults to SQLite files in backend/data/ and needs none of these.
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot
# DEMO_DATABASE_URL=postgresql://reader:password@localhost:5432/sales_demo
# DEMO_SEED_DATABASE_URL=postgresql://owner:password@localhost:5432/sales_demo

# Docker Compose passwords
POSTGRES_PASSWORD=datapilot
READER_PASSWORD=reader

# --- Query guard rails -------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000
MAX_SQL_REPAIR_ATTEMPTS=2
CONTEXT_TURNS=4
LOG_LEVEL=INFO
